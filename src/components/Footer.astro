---
const year = new Date().getFullYear();
---

<footer>
	<p>© {year} fengshihao</p>
</footer>

<style>
	footer {
		width: min(var(--max), calc(100% - 3rem));
		margin: 0 auto;
		padding: 0 0 3.5rem;
		color: var(--fg-3);
		font-size: 0.85rem;
	}

	p {
		margin: 0;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	@media (max-width: 640px) {
		footer {
			width: min(100% - 2rem, var(--max));
		}
	}
</style>
