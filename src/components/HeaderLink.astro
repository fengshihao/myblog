---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../lib/paths';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizedHref = typeof href === 'string' ? href : '/';
const resolvedHref = withBase(normalizedHref === '/' ? '' : normalizedHref);

const base = withBase();
const pathname = Astro.url.pathname.replace(base.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
const hrefPath = normalizedHref.replace(/\/$/, '') || '/';
const subpath = pathname.match(/[^\/]+/g);
const isActive = hrefPath === pathname || hrefPath === '/' + (subpath?.[0] || '');
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
