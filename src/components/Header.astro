---
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/paths';
---

<header transition:persist="site-header">
	<nav>
		<a class="brand" href={withBase()}>
			<img class="mark" src={withBase('favicon.svg')} width="32" height="32" alt="" />
			<span class="name">{SITE_TITLE}</span>
		</a>
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--line);
	}

	nav {
		width: min(var(--wide), calc(100% - 3rem));
		margin: 0 auto;
		padding: 1.25rem 0;
		display: flex;
		align-items: center;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--fg);
	}

	.brand:hover {
		opacity: 0.55;
	}

	.mark {
		display: block;
		width: 32px;
		height: 32px;
		flex-shrink: 0;
	}

	.name {
		font-size: 1.15em;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1;
	}

	@media (max-width: 640px) {
		nav {
			width: min(100% - 2rem, var(--wide));
			padding: 1rem 0;
		}
	}
</style>
